{
  "name": "crabcode",
  "displayName": "CrabCode",
  "description": "CrabCode Programming Assistant: Works seamlessly with the CrabCode gateway in the editor",
  "version": "0.1.6",
  "publisher": "crabcode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ylzz1997/crabcode.git",
    "directory": "packages/vscode"
  },
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "chat"
  ],
  "activationEvents": [
    "onCommand:crabcode.openChat",
    "onCommand:crabcode.explainCode",
    "onCommand:crabcode.fixCode",
    "onCommand:crabcode.sendToChat",
    "onCommand:crabcode.interrupt",
    "onCommand:crabcode.newSession",
    "onCommand:crabcode.connect",
    "onCommand:crabcode.disconnect",
    "onCommand:crabcode.installGatewaySuite",
    "onView:crabcode.chatPanel"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionPack": [
    "crabcode.crabcode-computer-use"
  ],
  "contributes": {
    "commands": [
      {
        "command": "crabcode.openMenu",
        "title": "CrabCode：打开菜单"
      },
      {
        "command": "crabcode.computerUse",
        "title": "CrabCode：Computer Use"
      },
      {
        "command": "crabcode.showLogs",
        "title": "CrabCode：查看日志"
      },
      {
        "command": "crabcode.openChat",
        "title": "CrabCode：打开聊天"
      },
      {
        "command": "crabcode.explainCode",
        "title": "CrabCode：解释选中代码"
      },
      {
        "command": "crabcode.fixCode",
        "title": "CrabCode：修复选中代码"
      },
      {
        "command": "crabcode.sendToChat",
        "title": "CrabCode：发送到聊天"
      },
      {
        "command": "crabcode.interrupt",
        "title": "CrabCode：中断当前任务"
      },
      {
        "command": "crabcode.newSession",
        "title": "CrabCode：新建会话"
      },
      {
        "command": "crabcode.openSettingsMenu",
        "title": "CrabCode：打开设置菜单"
      },
      {
        "command": "crabcode.openCrabCodeSettings",
        "title": "CrabCode：打开CrabCode设置"
      },
      {
        "command": "crabcode.openSettings",
        "title": "CrabCode：打开扩展设置"
      },
      {
        "command": "crabcode.openPromptSettings",
        "title": "CrabCode：打开提示词设置"
      },
      {
        "command": "crabcode.openContextSettings",
        "title": "CrabCode：打开上下文压缩设置"
      },
      {
        "command": "crabcode.connect",
        "title": "CrabCode：连接网关"
      },
      {
        "command": "crabcode.disconnect",
        "title": "CrabCode：断开网关"
      },
      {
        "command": "crabcode.refactorCode",
        "title": "CrabCode：重构选中代码"
      },
      {
        "command": "crabcode.addTests",
        "title": "CrabCode：为选中代码添加测试"
      },
      {
        "command": "crabcode.restartGateway",
        "title": "CrabCode：重启网关"
      },
      {
        "command": "crabcode.installGatewaySuite",
        "title": "CrabCode：选择并安装本地套件"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crabcode",
          "title": "crabcode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "crabcode": [
        {
          "id": "crabcode.chatPanel",
          "name": "crabcode",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "CrabCode",
      "properties": {
        "crabcode.serverUrl": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "string",
          "default": "ws://localhost:4096/ws",
          "description": "CrabCode 网关 WebSocket 地址（与 CrabCode 网关配置一致）"
        },
        "crabcode.password": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "string",
          "default": "",
          "description": "连接 CrabCode 网关时使用的访问密码（若网关启用鉴权）"
        },
        "crabcode.autoConnect": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": true,
          "description": "CrabCode 扩展激活后是否自动连接网关"
        },
        "crabcode.showDiffOnFileChange": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": false,
          "description": "CrabCode 修改文件后是否在编辑器中打开 diff 预览"
        },
        "crabcode.pendingEditsVisibleFiles": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "待审核修改面板一次可见的文件行数；超过后列表滚动"
        },
        "crabcode.autoCollapseProcess": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": true,
          "description": "本轮正常结束后，自动收起中间说明、思考和工具调用。最终回答保持展开，可随时查看完整过程。"
        },
        "crabcode.showToolCallCount": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": false,
          "description": "在处理状态旁显示本轮工具调用次数及错误次数。默认关闭。"
        },
        "crabcode.fileUploadMaxSizeMb": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 100,
          "description": "添加非图片文件并发送完整内容时的单文件大小上限（MB）"
        },
        "crabcode.followUpMode": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "queue",
            "steer"
          ],
          "enumDescriptions": [
            "排队：本轮结束后依次执行",
            "引导：在安全边界接入当前运行"
          ],
          "default": "queue",
          "description": "跟进处理方式。运行中 Enter 使用此方式，Ctrl/Cmd+Enter 对单条消息执行相反操作，Shift+Enter 换行。"
        },
        "crabcode.composerSendKey": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "enter",
            "mod_enter"
          ],
          "enumDescriptions": [
            "Enter 发送，系统对应的 Ctrl/Cmd+Enter 换行",
            "系统对应的 Ctrl/Cmd+Enter 发送，Enter 换行"
          ],
          "default": "enter",
          "description": "CrabCode 聊天输入框的发送快捷键"
        },
        "crabcode.computerUseEnabled": {
          "type": "boolean",
          "default": true,
          "description": "通过本机 CrabCode Computer Use 配套扩展启用原生组件，无需运行 Crab Desktop；可在状态栏 CrabCode 菜单的 Computer Use 中或设置中关闭。本地和 Remote SSH 窗口均需在本机安装配套扩展。"
        },
        "crabcode.computerUseTargetScope": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "app_window",
            "desktop"
          ],
          "enumDescriptions": [
            "Operate a specific macOS window.",
            "Operate the entire desktop; requires allow_foreground."
          ],
          "default": "app_window",
          "description": "Computer Use target. Explicit values override the Gateway setting."
        },
        "crabcode.computerUseDeliveryPolicy": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "strict_background",
            "allow_foreground"
          ],
          "enumDescriptions": [
            "Use process-targeted background input and never focus the target window.",
            "Allow activation and foreground interaction when background delivery is insufficient; may interrupt your work."
          ],
          "default": "allow_foreground",
          "description": "Computer Use foreground permission and fallback policy. This is independent of Full Access, and the agent cannot override it in an action."
        },
        "crabcode.computerUseMode": {
          "tags": [
            "crabcodeProduct"
          ],
          "deprecationMessage": "Use computerUseTargetScope and computerUseDeliveryPolicy. This legacy setting does not override foreground permission.",
          "type": "string",
          "enum": [
            "background_app",
            "foreground_desktop"
          ],
          "enumDescriptions": [
            "后台应用模式：按指定应用窗口操作，允许应用切到前台（当前仅支持 macOS）",
            "前台桌面模式：控制完整桌面、真实鼠标和键盘，会影响当前用户操作"
          ],
          "default": "background_app",
          "description": "Computer Use 操作模式；工作区或用户显式设置后覆盖 Gateway 的 computer_use.mode"
        },
        "crabcode.chatModels": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "CrabCode 聊天面板中的模型名称列表（须与网关侧 crabcode.toml 中 models 的键一致）"
        },
        "crabcode.chatModelDefault": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "default": "",
          "description": "CrabCode 聊天默认选中的模型（须为 chatModels 中一项；留空则取列表第一项）"
        },
        "crabcode.permissionMode": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "default",
            "ask",
            "ai_review",
            "run_everything"
          ],
          "default": "default",
          "description": "CrabCode 工具权限：default 使用当前工作区加载的权限规则；ask 在高风险操作前确认；ai_review 使用 AI 审查；run_everything 自动批准所有工具。"
        },
        "crabcode.pythonPath": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "string",
          "default": "",
          "description": "Python 可执行文件路径（留空则自动检测 python3 / python）"
        },
        "crabcode.gatewayAutoInstall": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": true,
          "description": "当检测不到 crabcode-gateway 时是否自动安装并启动",
          "markdownDescription": "当检测不到本地 Gateway 时，自动安装轻量的 `crabcode[gateway]` 并启动。需要可选能力时，可[勾选并安装其他组件](command:crabcode.installGatewaySuite)。"
        },
        "crabcode.debugLogRawWsPayload": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": false,
          "description": "调试用：在 CrabCode 输出中打印 WebSocket 收发原始 JSON（会截断，可能包含敏感文本）"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "crabcode.explainCode",
          "when": "editorHasSelection",
          "group": "crabcode@1"
        },
        {
          "command": "crabcode.fixCode",
          "when": "editorHasSelection",
          "group": "crabcode@2"
        },
        {
          "command": "crabcode.refactorCode",
          "when": "editorHasSelection",
          "group": "crabcode@3"
        },
        {
          "command": "crabcode.addTests",
          "when": "editorHasSelection",
          "group": "crabcode@4"
        },
        {
          "command": "crabcode.sendToChat",
          "when": "editorHasSelection",
          "group": "crabcode@5"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "computer-use:build": "node ../computer-use/scripts/build.mjs --out resources/computer-use --sync-local-clients",
    "build": "node esbuild.js --production",
    "prewatch": "npm run computer-use:build -- --debug && npm --prefix computer-use run build",
    "watch": "node esbuild.js",
    "test": "node --test tests/*.test.cjs",
    "lint": "tsc --noEmit && tsc -p tsconfig.webview.json && node ../../scripts/audit_tool_cards.mjs",
    "package": "vsce package"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.14",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0"
  }
}
