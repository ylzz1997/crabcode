{
  "name": "crabcode",
  "displayName": "CrabCode",
  "description": "CrabCode 编程助手：在编辑器中与 CrabCode 网关协同工作",
  "version": "0.1.4",
  "publisher": "crabcode",
  "license": "MIT",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "chat"
  ],
  "activationEvents": [
    "onCommand:crabcode.openChat",
    "onCommand:crabcode.explainCode",
    "onCommand:crabcode.fixCode",
    "onCommand:crabcode.sendToChat",
    "onCommand:crabcode.interrupt",
    "onCommand:crabcode.newSession",
    "onCommand:crabcode.connect",
    "onCommand:crabcode.disconnect",
    "onView:crabcode.chatPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "crabcode.openChat",
        "title": "CrabCode：打开聊天"
      },
      {
        "command": "crabcode.explainCode",
        "title": "CrabCode：解释选中代码"
      },
      {
        "command": "crabcode.fixCode",
        "title": "CrabCode：修复选中代码"
      },
      {
        "command": "crabcode.sendToChat",
        "title": "CrabCode：发送到聊天"
      },
      {
        "command": "crabcode.interrupt",
        "title": "CrabCode：中断当前任务"
      },
      {
        "command": "crabcode.newSession",
        "title": "CrabCode：新建会话"
      },
      {
        "command": "crabcode.openSettings",
        "title": "CrabCode：打开扩展设置"
      },
      {
        "command": "crabcode.connect",
        "title": "CrabCode：连接网关"
      },
      {
        "command": "crabcode.disconnect",
        "title": "CrabCode：断开网关"
      },
      {
        "command": "crabcode.refactorCode",
        "title": "CrabCode：重构选中代码"
      },
      {
        "command": "crabcode.addTests",
        "title": "CrabCode：为选中代码添加测试"
      },
      {
        "command": "crabcode.restartGateway",
        "title": "CrabCode：重启网关"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crabcode",
          "title": "CrabCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "crabcode": [
        {
          "id": "crabcode.chatPanel",
          "name": "CrabCode 聊天",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "CrabCode",
      "properties": {
        "crabcode.serverUrl": {
          "type": "string",
          "default": "ws://localhost:4096/ws",
          "description": "CrabCode 网关 WebSocket 地址（与 CrabCode 网关配置一致）"
        },
        "crabcode.password": {
          "type": "string",
          "default": "",
          "description": "连接 CrabCode 网关时使用的访问密码（若网关启用鉴权）"
        },
        "crabcode.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "CrabCode 扩展激活后是否自动连接网关"
        },
        "crabcode.showDiffOnFileChange": {
          "type": "boolean",
          "default": false,
          "description": "CrabCode 修改文件后是否在编辑器中打开 diff 预览"
        },
        "crabcode.pendingEditsVisibleFiles": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "待审核修改面板一次可见的文件行数；超过后列表滚动"
        },
        "crabcode.chatModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "CrabCode 聊天面板中的模型名称列表（须与网关侧 crabcode.toml 中 models 的键一致）"
        },
        "crabcode.chatModelDefault": {
          "type": "string",
          "default": "",
          "description": "CrabCode 聊天默认选中的模型（须为 chatModels 中一项；留空则取列表第一项）"
        },
        "crabcode.permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "ask",
            "ai_review",
            "run_everything"
          ],
          "default": "default",
          "description": "CrabCode 工具权限：default 跟随 settings.json；ask 按规则询问；ai_review 使用 AI 审查工具调用；run_everything 自动批准工具"
        },
        "crabcode.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 可执行文件路径（留空则自动检测 python3 / python）"
        },
        "crabcode.gatewayAutoInstall": {
          "type": "boolean",
          "default": true,
          "description": "当检测不到 crabcode-gateway 时是否自动安装并启动"
        },
        "crabcode.debugLogRawWsPayload": {
          "type": "boolean",
          "default": false,
          "description": "调试用：在 CrabCode 输出中打印 WebSocket 收发原始 JSON（会截断，可能包含敏感文本）"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "crabcode.explainCode",
          "when": "editorHasSelection",
          "group": "crabcode@1"
        },
        {
          "command": "crabcode.fixCode",
          "when": "editorHasSelection",
          "group": "crabcode@2"
        },
        {
          "command": "crabcode.refactorCode",
          "when": "editorHasSelection",
          "group": "crabcode@3"
        },
        {
          "command": "crabcode.addTests",
          "when": "editorHasSelection",
          "group": "crabcode@4"
        },
        {
          "command": "crabcode.sendToChat",
          "when": "editorHasSelection",
          "group": "crabcode@5"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js",
    "lint": "tsc --noEmit",
    "package": "vsce package"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
