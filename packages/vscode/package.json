{
  "name": "crabcode",
  "displayName": "CrabCode",
  "description": "%description%",
  "version": "0.1.7",
  "publisher": "crabcode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ylzz1997/crabcode.git",
    "directory": "packages/vscode"
  },
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "chat"
  ],
  "activationEvents": [
    "onCommand:crabcode.openChat",
    "onCommand:crabcode.explainCode",
    "onCommand:crabcode.fixCode",
    "onCommand:crabcode.sendToChat",
    "onCommand:crabcode.interrupt",
    "onCommand:crabcode.newSession",
    "onCommand:crabcode.connect",
    "onCommand:crabcode.disconnect",
    "onCommand:crabcode.installGatewaySuite",
    "onView:crabcode.chatPanel"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionPack": [
    "crabcode.crabcode-computer-use"
  ],
  "contributes": {
    "commands": [
      {
        "command": "crabcode.openMenu",
        "title": "%contributes.commands.0.title%"
      },
      {
        "command": "crabcode.computerUse",
        "title": "%contributes.commands.1.title%"
      },
      {
        "command": "crabcode.showLogs",
        "title": "%contributes.commands.2.title%"
      },
      {
        "command": "crabcode.openChat",
        "title": "%contributes.commands.3.title%"
      },
      {
        "command": "crabcode.explainCode",
        "title": "%contributes.commands.4.title%"
      },
      {
        "command": "crabcode.fixCode",
        "title": "%contributes.commands.5.title%"
      },
      {
        "command": "crabcode.sendToChat",
        "title": "%contributes.commands.6.title%"
      },
      {
        "command": "crabcode.interrupt",
        "title": "%contributes.commands.7.title%"
      },
      {
        "command": "crabcode.newSession",
        "title": "%contributes.commands.8.title%"
      },
      {
        "command": "crabcode.openSettingsMenu",
        "title": "%contributes.commands.9.title%"
      },
      {
        "command": "crabcode.openCrabCodeSettings",
        "title": "%contributes.commands.10.title%"
      },
      {
        "command": "crabcode.openSettings",
        "title": "%contributes.commands.11.title%"
      },
      {
        "command": "crabcode.openPromptSettings",
        "title": "%contributes.commands.12.title%"
      },
      {
        "command": "crabcode.openContextSettings",
        "title": "%contributes.commands.13.title%"
      },
      {
        "command": "crabcode.connect",
        "title": "%contributes.commands.14.title%"
      },
      {
        "command": "crabcode.disconnect",
        "title": "%contributes.commands.15.title%"
      },
      {
        "command": "crabcode.refactorCode",
        "title": "%contributes.commands.16.title%"
      },
      {
        "command": "crabcode.addTests",
        "title": "%contributes.commands.17.title%"
      },
      {
        "command": "crabcode.restartGateway",
        "title": "%contributes.commands.18.title%"
      },
      {
        "command": "crabcode.installGatewaySuite",
        "title": "%contributes.commands.19.title%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crabcode",
          "title": "%contributes.viewsContainers.activitybar.0.title%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "crabcode": [
        {
          "id": "crabcode.chatPanel",
          "name": "crabcode",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "CrabCode",
      "properties": {
        "crabcode.serverUrl": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "string",
          "default": "ws://localhost:4096/ws",
          "description": "%contributes.configuration.properties.crabcode.serverUrl.description%"
        },
        "crabcode.password": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "string",
          "default": "",
          "description": "%contributes.configuration.properties.crabcode.password.description%"
        },
        "crabcode.autoConnect": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": true,
          "description": "%contributes.configuration.properties.crabcode.autoConnect.description%"
        },
        "crabcode.showDiffOnFileChange": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": false,
          "description": "%contributes.configuration.properties.crabcode.showDiffOnFileChange.description%"
        },
        "crabcode.pendingEditsVisibleFiles": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "%contributes.configuration.properties.crabcode.pendingEditsVisibleFiles.description%"
        },
        "crabcode.autoCollapseProcess": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": true,
          "description": "%contributes.configuration.properties.crabcode.autoCollapseProcess.description%"
        },
        "crabcode.showToolCallCount": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": false,
          "description": "%contributes.configuration.properties.crabcode.showToolCallCount.description%"
        },
        "crabcode.fileUploadMaxSizeMb": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 100,
          "description": "%contributes.configuration.properties.crabcode.fileUploadMaxSizeMb.description%"
        },
        "crabcode.followUpMode": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "queue",
            "steer"
          ],
          "enumDescriptions": [
            "%contributes.configuration.properties.crabcode.followUpMode.enumDescriptions.0%",
            "%contributes.configuration.properties.crabcode.followUpMode.enumDescriptions.1%"
          ],
          "default": "queue",
          "description": "%contributes.configuration.properties.crabcode.followUpMode.description%"
        },
        "crabcode.composerSendKey": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "enter",
            "mod_enter"
          ],
          "enumDescriptions": [
            "%contributes.configuration.properties.crabcode.composerSendKey.enumDescriptions.0%",
            "%contributes.configuration.properties.crabcode.composerSendKey.enumDescriptions.1%"
          ],
          "default": "enter",
          "description": "%contributes.configuration.properties.crabcode.composerSendKey.description%"
        },
        "crabcode.computerUseEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%contributes.configuration.properties.crabcode.computerUseEnabled.description%"
        },
        "crabcode.computerUseTargetScope": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "app_window",
            "desktop"
          ],
          "enumDescriptions": [
            "%contributes.configuration.properties.crabcode.computerUseTargetScope.enumDescriptions.0%",
            "%contributes.configuration.properties.crabcode.computerUseTargetScope.enumDescriptions.1%"
          ],
          "default": "app_window",
          "description": "%contributes.configuration.properties.crabcode.computerUseTargetScope.description%"
        },
        "crabcode.computerUseDeliveryPolicy": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "strict_background",
            "allow_foreground"
          ],
          "enumDescriptions": [
            "%contributes.configuration.properties.crabcode.computerUseDeliveryPolicy.enumDescriptions.0%",
            "%contributes.configuration.properties.crabcode.computerUseDeliveryPolicy.enumDescriptions.1%"
          ],
          "default": "allow_foreground",
          "description": "%contributes.configuration.properties.crabcode.computerUseDeliveryPolicy.description%"
        },
        "crabcode.computerUseMode": {
          "tags": [
            "crabcodeProduct"
          ],
          "deprecationMessage": "%contributes.configuration.properties.crabcode.computerUseMode.deprecationMessage%",
          "type": "string",
          "enum": [
            "background_app",
            "foreground_desktop"
          ],
          "enumDescriptions": [
            "%contributes.configuration.properties.crabcode.computerUseMode.enumDescriptions.0%",
            "%contributes.configuration.properties.crabcode.computerUseMode.enumDescriptions.1%"
          ],
          "default": "background_app",
          "description": "%contributes.configuration.properties.crabcode.computerUseMode.description%"
        },
        "crabcode.chatModels": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%contributes.configuration.properties.crabcode.chatModels.description%"
        },
        "crabcode.chatModelDefault": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "default": "",
          "description": "%contributes.configuration.properties.crabcode.chatModelDefault.description%"
        },
        "crabcode.permissionMode": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "enum": [
            "default",
            "ask",
            "ai_review",
            "run_everything"
          ],
          "default": "default",
          "description": "%contributes.configuration.properties.crabcode.permissionMode.description%"
        },
        "crabcode.pythonPath": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "string",
          "default": "",
          "description": "%contributes.configuration.properties.crabcode.pythonPath.description%"
        },
        "crabcode.gatewayAutoInstall": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": true,
          "description": "%contributes.configuration.properties.crabcode.gatewayAutoInstall.description%",
          "markdownDescription": "%contributes.configuration.properties.crabcode.gatewayAutoInstall.markdownDescription%"
        },
        "crabcode.debugLogRawWsPayload": {
          "tags": [
            "crabcodeExtension"
          ],
          "type": "boolean",
          "default": false,
          "description": "%contributes.configuration.properties.crabcode.debugLogRawWsPayload.description%"
        },
        "crabcode.language": {
          "tags": [
            "crabcodeProduct"
          ],
          "type": "string",
          "scope": "window",
          "enum": [
            "auto",
            "zh-CN",
            "zh-TW",
            "en",
            "ja",
            "ko",
            "de",
            "fr",
            "es",
            "pt-BR",
            "ru"
          ],
          "enumDescriptions": [
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.0%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.1%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.2%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.3%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.4%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.5%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.6%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.7%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.8%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.9%",
            "%contributes.configuration.properties.crabcode.language.enumDescriptions.10%"
          ],
          "default": "auto",
          "description": "%contributes.configuration.properties.crabcode.language.description%"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "crabcode.explainCode",
          "when": "editorHasSelection",
          "group": "crabcode@1"
        },
        {
          "command": "crabcode.fixCode",
          "when": "editorHasSelection",
          "group": "crabcode@2"
        },
        {
          "command": "crabcode.refactorCode",
          "when": "editorHasSelection",
          "group": "crabcode@3"
        },
        {
          "command": "crabcode.addTests",
          "when": "editorHasSelection",
          "group": "crabcode@4"
        },
        {
          "command": "crabcode.sendToChat",
          "when": "editorHasSelection",
          "group": "crabcode@5"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "computer-use:build": "node ../computer-use/scripts/build.mjs --out resources/computer-use --sync-local-clients",
    "build": "node ../../scripts/i18n.mjs && node esbuild.js --production",
    "prewatch": "npm run computer-use:build -- --debug && npm --prefix computer-use run build",
    "watch": "node esbuild.js",
    "test": "node --test ../shared/i18n/*.test.mjs tests/*.test.cjs",
    "lint": "tsc --noEmit && tsc -p tsconfig.webview.json && node ../../scripts/audit_tool_cards.mjs",
    "package": "vsce package",
    "i18n:check": "node ../../scripts/i18n.mjs",
    "i18n:extract": "node ../../scripts/i18n.mjs --extract"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.14",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0"
  }
}
