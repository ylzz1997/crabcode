{
  "name": "crabcode-desktop",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "computer-use:build": "node ../computer-use/scripts/build.mjs --out src-tauri/resources/computer-use --sync-local-clients",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "node ../../scripts/i18n.mjs && node ../../scripts/audit_tool_cards.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "test": "vitest run",
    "i18n:check": "node ../../scripts/i18n.mjs",
    "i18n:extract": "node ../../scripts/i18n.mjs --extract"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.3",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
